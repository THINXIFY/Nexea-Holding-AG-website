# Contact form email delivery (server-side only; never prefix these with NEXT_PUBLIC_).
# Provider: Resend (https://resend.com). The sender domain must be verified there.

# API key from the delivery provider (required)
RESEND_API_KEY=

# Verified sender, e.g. "Nexea Website <website@nexea-holding.com>" (required)
CONTACT_FROM_EMAIL=

# Where enquiries are delivered (optional, defaults to info@nexea-holding.com)
CONTACT_TO_EMAIL=info@nexea-holding.com

# Optional provider endpoint override. Leave empty in production.
RESEND_API_URL=

# ---- Private document requests (OTP-verified email delivery) ----
# Secret used to protect stored one-time codes. Required in production; use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=
# Optional tuning
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Optional: dedicated sender for these emails (defaults to CONTACT_FROM_EMAIL)
DOCUMENTS_FROM_EMAIL=
# Optional: where the PDFs live (default ./private/documents) and where challenges are stored (default ./.data)
DOCUMENTS_DIR=
OTP_STORE_PATH=
